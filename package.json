{
  "name": "mini-program-operate",
  "version": "1.0.0",
  "license": "MIT",
  "main": "electron/main.js",
  "author": {
    "name": "xiaolong.su",
    "email": "xiaolong.su@xglq.com"
  },
  "engines": {
    "node": ">= 18",
    "pnpm": ">= 9"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check build-only",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit",
    "lint:eslint": "eslint . --fix",
    "lint:prettier": "prettier --write  \"src/**/*.{js,ts,json,tsx,css,less,scss,vue,html,md}\"",
    "release": "standard-version",
    "prepare": "husky install",
    "electron": "electron .",
    "build:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.xglq.app",
    "productName": "MiniProgramOperate",
    "compression": "maximum",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "LICENSE.txt",
      "logo.ico",
      "./dist/**/*",
      "!**/node_modules/**/*.{md,mdx}",
      "!tests/**"
    ],
    "asar": true,
    "extraResources": [
      "extra/**"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        "portable",
        "zip"
      ],
      "icon": "./logo.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "allowElevation": true,
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "license": "LICENSE.txt"
    },
    "publish": {
      "provider": "github",
      "releaseType": "release",
      "owner": "xiaolong.su",
      "repo": "mini-program-operate"
    }
  },
  "dependencies": {
    "axios": "^1.13.2",
    "clsx": "^2.1.1",
    "electron-updater": "^6.6.2",
    "normalize.css": "^8.0.1",
    "nprogress": "^0.2.0",
    "pinia": "^2.3.1",
    "pinia-plugin-persistedstate": "^3.2.1",
    "tailwind-merge": "^2.6.0",
    "vant": "^4.9.21",
    "vue": "^3.5.24",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.39.1",
    "@iconify-icons/fa6-solid": "^1.2.13",
    "@iconify/vue": "^4.3.0",
    "@rushstack/eslint-patch": "^1.14.1",
    "@types/node": "^22.19.0",
    "@types/nprogress": "^0.2.3",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitejs/plugin-vue-jsx": "^4.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.5.1",
    "autoprefixer": "^10.4.21",
    "cnjm-postcss-px-to-viewport": "^1.0.1",
    "commitlint": "^19.8.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-define-config": "^2.1.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "less": "^4.4.2",
    "mockjs": "^1.1.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.6",
    "postcss-rem-to-pixel": "^4.1.2",
    "prettier": "^3.6.2",
    "standard-version": "^9.5.0",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.46.3",
    "unplugin-vue-components": "^0.27.5",
    "vite": "^5.4.21",
    "vite-plugin-cdn2": "^1.1.0",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-mock-dev-server": "^1.9.3",
    "vite-plugin-svg-icons": "^2.0.1",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.2.12"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "rollup"
      ],
      "allowedVersions": {
        "eslint": "9"
      }
    }
  }
}
